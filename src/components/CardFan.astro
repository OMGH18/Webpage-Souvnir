---
// Éventail de l'ouverture : trois Souvnirs (messages vocaux déposés à un lieu).
// Illustrations, pas de vrais messages.
import { Image } from 'astro:assets'
import map from '../assets/art/carte.png'
import sealed from '../assets/art/mascot-sealed.png'
import type { Lang } from '../data/product'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const wave = [6, 12, 18, 10, 22, 14, 8, 16, 24, 12, 7, 15, 20, 11, 6, 13, 18, 9]
---

<div class="fan" aria-hidden="true">
  <div class="holo c-left">
    <div class="face">
      <div class="art paper env">
        <Image class="seal" src={sealed} alt="" width={300} loading="eager" />
        <span class="lock">{fr ? 'S’ouvre sur place' : 'Opens on site'}</span>
      </div>
      <div class="foot"><b>{fr ? 'Pour Inès' : 'For Inès'}</b><small>{fr ? 'Alfama · Lisbonne' : 'Alfama · Lisbon'}</small></div>
    </div>
  </div>
  <div class="holo c-right">
    <div class="face">
      <div class="art paper quote">
        <span class="q">“</span>
        <p>{fr ? 'Si tu écoutes ça, tu sais pourquoi cet endroit compte pour moi.' : 'If you’re hearing this, you know why this place matters to me.'}</p>
      </div>
      <div class="foot"><b>{fr ? 'De Léo' : 'From Léo'}</b><small>{fr ? 'Pont des Arts · 0:24' : 'Pont des Arts · 0:24'}</small></div>
    </div>
  </div>
  <div class="holo c-mid">
    <div class="face">
      <div class="art night">
        <Image class="bg" src={map} alt="" width={460} loading="eager" fetchpriority="high" />
        <span class="pin"><span></span></span>
        <span class="here">{fr ? 'Un Souvnir t’attend ici' : 'A Souvnir is waiting here'}</span>
      </div>
      <div class="foot player">
        <span class="play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
        <span class="wave">{wave.map((h) => <i style={`height:${h}px`}></i>)}</span>
        <span class="dur">0:18</span>
      </div>
      <div class="foot under"><b>{fr ? 'De Camille' : 'From Camille'}</b><small>Le Marais · Paris</small></div>
    </div>
  </div>
</div>

<style>
  @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .fan { --w: clamp(140px, 19vw, 240px); --sx: 72%; --sy: 15%; position: relative; width: 100%; height: calc(var(--w) * 1.78); }
  @media (max-width: 520px) { .fan { --sx: 64%; --sy: 24%; height: calc(var(--w) * 1.92); } }
  .holo {
    position: absolute; left: calc(50% - var(--w) / 2); top: 3%; width: var(--w);
    padding: 2.5px; border-radius: 22px;
    background: conic-gradient(from var(--a), #c9a84c, #f2ead8, #c4693d, #dbbf6a, #8e5e3e, #c9a84c);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6), 0 0 44px rgba(201, 168, 76, 0.18);
    animation: holo 10s linear infinite;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes holo { to { --a: 360deg; } }
  .c-left { transform: translateX(calc(-1 * var(--sx))) translateY(var(--sy)) rotate(-9deg); }
  .c-right { transform: translateX(var(--sx)) translateY(var(--sy)) rotate(9deg); }
  .c-right .foot { text-align: right; }
  .c-mid { transform: translateY(-2%); z-index: 2; }
  .fan:hover .c-left { transform: translateX(calc(-1 * var(--sx) - 8%)) translateY(calc(var(--sy) - 2%)) rotate(-12deg); }
  .fan:hover .c-right { transform: translateX(calc(var(--sx) + 8%)) translateY(calc(var(--sy) - 2%)) rotate(12deg); }
  .fan:hover .c-mid { transform: translateY(-5%); }

  .face { position: relative; overflow: hidden; border-radius: 20px; background: var(--surface); }
  .face::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; mix-blend-mode: soft-light;
    background: linear-gradient(115deg, transparent 30%, rgba(255, 248, 230, 0.55) 45%, rgba(201, 168, 76, 0.35) 52%, transparent 65%) -120% 0 / 250% 100% no-repeat;
    animation: shine 7s ease-in-out infinite;
  }
  .c-left .face::after { animation-delay: 1.4s; }
  .c-right .face::after { animation-delay: 2.8s; }
  @keyframes shine { 0%, 55% { background-position: 120% 0; } 100% { background-position: -120% 0; } }

  .art { position: relative; aspect-ratio: 1; overflow: hidden; display: grid; place-items: center; }
  .foot { display: grid; gap: 2px; padding: 10px 13px 12px; border-top: 1px solid var(--border); }
  .foot b { font-family: var(--font-brand); font-weight: 600; font-style: italic; font-size: calc(var(--w) * 0.085); line-height: 1.15; color: var(--text); }
  .foot small { font-size: calc(var(--w) * 0.052); color: var(--faint); font-weight: 500; }

  /* Papier crème (couleurs « parchment » de l'app) */
  .paper { background: radial-gradient(90% 90% at 30% 20%, #fdf6ee, #ede3d1 70%, #dccbb5); color: #2c2420; }
  .env :global(.seal) { width: 74%; height: auto; margin-top: -8%; filter: drop-shadow(0 10px 14px rgba(44, 36, 32, 0.25)); }
  .lock { position: absolute; bottom: 9%; left: 9%; white-space: nowrap; font-size: calc(var(--w) * 0.05); font-weight: 600; color: #a85530; background: rgba(196, 105, 61, 0.12); border: 1px solid rgba(196, 105, 61, 0.35); padding: 3px 9px; border-radius: 999px; }
  .quote { padding: 12% 10% 12% 22%; place-items: end; align-content: center; text-align: right; }
  .quote .q { font-family: var(--font-brand); font-size: calc(var(--w) * 0.3); line-height: 0.5; color: #c4693d; height: calc(var(--w) * 0.12); }
  .quote p { margin: 0; font-family: var(--font-brand); font-style: italic; font-size: calc(var(--w) * 0.075); line-height: 1.35; }

  /* Nuit : la carte de l'app et un repère doré */
  .night { background: #0b0f17; }
  .night :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .night::before { content: ''; position: absolute; inset: 0; z-index: 1; background: radial-gradient(45% 45% at 50% 48%, rgba(201, 168, 76, 0.22), transparent 70%), linear-gradient(180deg, rgba(14, 17, 23, 0.1), rgba(14, 17, 23, 0.65)); }
  .pin { position: relative; z-index: 2; width: calc(var(--w) * 0.13); height: calc(var(--w) * 0.13); border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: linear-gradient(135deg, #f2ead8, #c9a84c); box-shadow: 0 0 24px rgba(219, 191, 106, 0.9); display: grid; place-items: center; }
  .pin span { width: 38%; height: 38%; border-radius: 50%; background: #0e1117; }
  .pin::after { content: ''; position: absolute; inset: -60%; border-radius: 50%; border: 2px solid rgba(219, 191, 106, 0.5); transform: rotate(45deg); animation: ring 2.6s ease-out infinite; }
  @keyframes ring { from { transform: scale(0.5); opacity: 1; } to { transform: scale(1.4); opacity: 0; } }
  .here { position: absolute; z-index: 2; bottom: 8%; left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: calc(var(--w) * 0.055); font-weight: 600; color: var(--text); background: rgba(14, 17, 23, 0.78); border: 1px solid rgba(201, 168, 76, 0.4); padding: 4px 10px; border-radius: 999px; }
  .player { grid-template-columns: auto 1fr auto; align-items: center; gap: 8px; padding-bottom: 8px; }
  .play { width: calc(var(--w) * 0.13); height: calc(var(--w) * 0.13); border-radius: 50%; display: grid; place-items: center; background: var(--accent); }
  .play svg { width: 55%; height: 55%; fill: #fff; margin-left: 8%; }
  .wave { display: flex; align-items: center; gap: 2px; height: 26px; overflow: hidden; }
  .wave i { flex: 1; min-width: 2px; border-radius: 2px; background: var(--gold); opacity: 0.85; }
  .dur { font-size: calc(var(--w) * 0.05); color: var(--muted); font-variant-numeric: tabular-nums; }
  .under { border-top: 0; padding-top: 0; }

  @media (prefers-reduced-motion: reduce) {
    .holo, .face::after, .pin::after { animation: none; }
  }
</style>
