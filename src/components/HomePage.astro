---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import StoreButtons from './StoreButtons.astro'
import PricingPanel from './PricingPanel.astro'
import Faq from './Faq.astro'
import CtaBand from './CtaBand.astro'
import CardFan from './CardFan.astro'
import mapWide from '../assets/art/carte-wide.png'
import map from '../assets/art/carte.png'
import pointing from '../assets/art/mascot-pointing.png'
import shush from '../assets/art/mascot-shush.png'
import celebrate from '../assets/art/mascot-celebrate.png'
import sealed from '../assets/art/mascot-sealed.png'
import { LIMITS, PRICES, SITE, formatPrice, type Lang } from '../data/product'
import { ROUTES } from '../i18n/ui'
import { app, faqPage, organization, website } from '../data/schema'

interface Props { lang: Lang }
const { lang } = Astro.props
const fr = lang === 'fr'
const p = (v: number) => formatPrice(v, lang)
const premiumMin = `1 min ${LIMITS.premium.seconds - 60}`

const c = fr
  ? {
      title: 'Souvnir : des messages vocaux à redécouvrir au bon endroit',
      description: 'Souvnir te permet de laisser un message vocal attaché à un lieu. Quand la bonne personne repasse par là, l’app le lui fait écouter. Gratuit sur iPhone.',
      h1a: 'Les messages qu’on n’entend',
      h1b: 'qu’au bon endroit.',
      lede: 'Souvnir est une app iPhone gratuite pour laisser un message vocal attaché à un lieu.',
      lede2: 'Quand la personne que tu as choisie repasse par là, Souvnir lui rappelle qu’un message l’attend.',
      howCta: 'Comment ça marche',
      trust: [
        { t: 'Gratuit', s: `Jusqu’à ${LIMITS.free.notes} Souvnirs actifs`, svg: 'M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 8h20v4H2zM12 21V8m0 0H7.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8Zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 3 12 8 12 8Z' },
        { t: 'Ta voix', s: `${LIMITS.free.seconds} s, ou ${premiumMin} avec Souvnir+`, svg: 'M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Zm7 9a7 7 0 0 1-14 0m7 7v2' },
        { t: 'Sans publicité', s: 'Tes données ne sont pas vendues', svg: 'M12 3 4 6v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V6l-8-3Z' },
      ],
      howTitle: 'Crée. Place. Redécouvre.',
      howSub: 'Pas besoin d’organiser un album ni d’écrire des pages entières : un Souvnir commence par quelques secondes de ta voix.',
      steps: [
        { t: 'Enregistre ce que tu veux laisser', s: 'Une pensée, une anecdote, une recommandation. Ajoute une photo si le moment en mérite une.' },
        { t: 'Choisis l’endroit', s: 'Pose ton Souvnir sur la carte, là où le message prend son sens. Pour toi ou pour un proche.' },
        { t: 'Laisse le lieu faire le reste', s: 'Quand on repasse près de cet endroit, Souvnir prévient qu’un message y attend d’être écouté.' },
      ],
      feats: [
        { t: 'Prévenu quand tu passes à côté', s: 'Une notification quand un Souvnir t’attend tout près, même quand l’app est fermée.', mock: 'notif' },
        { t: 'Une photo avec ta voix', s: 'Le lieu, le moment, et ce que tu voulais dire.', mock: 'photo' },
        { t: 'Ta flamme', s: 'Dépose un Souvnir chaque jour et garde ta série allumée.', mock: 'flame' },
      ],
      notif: { app: 'Souvnir', t: 'Un Souvnir t’attend tout près', s: 'De Camille · à 80 m' },
      flameLabel: 'jours de flamme',
      ideasTitle: 'Certains messages ont besoin d’un lieu.',
      ideas: [
        { t: 'Couple', s: 'Quelques mots là où votre histoire a commencé : un premier rendez-vous, une rue où vous avez vécu.', img: 'shush' },
        { t: 'Amis', s: 'Blagues, anecdotes, messages cachés : transformez votre ville en carte de souvenirs.', img: 'celebrate' },
        { t: 'Voyage', s: 'Partage tes bonnes adresses au moment où elles deviennent utiles : un café à Lisbonne, une vue à Rome.', img: 'pointing' },
        { t: 'Pour toi', s: 'Une carte qui n’appartient qu’à toi : ce que tu pensais, ressentais ou voulais te rappeler.', img: 'sealed' },
      ],
      cmpTitleA: 'Une messagerie envoie un message maintenant.',
      cmpTitleB: 'Souvnir le laisse quelque part.',
      cmpA: { t: 'Message classique', q: '« Tu me manques. »', l: ['Il part maintenant.', 'Puis il disparaît dans la conversation.'] },
      cmpB: { t: 'Un Souvnir', q: '« Écoute-moi ici. »', l: ['Il voyage avec le lieu.', 'Et revient quand le moment compte.'] },
      privTitleA: 'Ta voix, tes lieux,', privTitleB: 'ton contrôle.',
      privBody: 'Un Souvnir peut rester personnel ou être partagé avec les personnes que tu choisis, et seulement elles.',
      privList: ['Données chiffrées en transit et au repos', 'Aucune donnée personnelle vendue, aucune publicité', 'Localisation utilisée seulement pour placer tes Souvnirs et te prévenir', 'Suppression du compte et de son contenu possible'],
      privCta: 'Lire la politique de confidentialité',
      priceTitleA: 'Commence gratuitement.', priceTitleB: 'Passe à Souvnir+ quand tu veux.',
      faqTitle: 'Questions fréquentes',
      faq: [
        { q: 'Qu’est-ce qu’un Souvnir ?', a: 'Une note vocale attachée à un lieu. Tu peux y ajouter une photo, la garder pour toi ou la partager avec un proche.' },
        { q: 'Que se passe-t-il quand je repasse près du lieu ?', a: 'Souvnir utilise ta localisation pour reconnaître que tu approches d’un lieu où un Souvnir t’attend, et t’envoie une notification, même quand l’app est fermée.' },
        { q: 'Souvnir est-il gratuit ?', a: `Oui. En gratuit, tu peux avoir jusqu’à ${LIMITS.free.notes} Souvnirs actifs et ${LIMITS.free.friends} amis, avec des vocaux de ${LIMITS.free.seconds} secondes ; un Souvnir s’efface après avoir été écouté sur place. Souvnir+ (${p(PRICES.monthly)} par mois ou ${p(PRICES.yearly)} par an) retire ces limites et garde tes Souvnirs après écoute.` },
        { q: 'Puis-je garder mes Souvnirs privés ?', a: 'Oui. Un Souvnir peut être créé pour toi seul, ou partagé uniquement avec les personnes que tu choisis.' },
        { q: 'Pourquoi Souvnir a-t-il besoin de ma localisation ?', a: 'Pour associer tes Souvnirs à des lieux et te prévenir quand tu es près de l’un d’eux. Tu peux désactiver l’accès à la localisation à tout moment dans les réglages de ton iPhone.' },
        { q: 'Souvnir est-il disponible sur Android ?', a: 'Pas pour l’instant : Souvnir est disponible sur iPhone, en français et en anglais.' },
      ],
    }
  : {
      title: 'Souvnir: voice messages you rediscover in the right place',
      description: 'Souvnir lets you leave a voice message tied to a place. When the right person passes by again, the app lets them hear it. Free on iPhone.',
      h1a: 'Messages you only hear',
      h1b: 'in the right place.',
      lede: 'Souvnir is a free iPhone app to leave a voice message tied to a place.',
      lede2: 'When the person you chose passes by again, Souvnir reminds them a message is waiting.',
      howCta: 'How it works',
      trust: [
        { t: 'Free', s: `Up to ${LIMITS.free.notes} active Souvnirs`, svg: 'M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 8h20v4H2zM12 21V8m0 0H7.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8Zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 3 12 8 12 8Z' },
        { t: 'Your voice', s: `${LIMITS.free.seconds} s, or ${premiumMin} with Souvnir+`, svg: 'M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Zm7 9a7 7 0 0 1-14 0m7 7v2' },
        { t: 'No ads', s: 'Your data is never sold', svg: 'M12 3 4 6v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V6l-8-3Z' },
      ],
      howTitle: 'Create. Place. Rediscover.',
      howSub: 'No album to organise, no pages to write: a Souvnir starts with a few seconds of your voice.',
      steps: [
        { t: 'Record what you want to leave', s: 'A thought, a story, a recommendation. Add a photo if the moment deserves one.' },
        { t: 'Pick the spot', s: 'Drop your Souvnir on the map, where the message makes sense. For yourself or for someone close.' },
        { t: 'Let the place do the rest', s: 'When someone passes near that spot again, Souvnir lets them know a message is waiting.' },
      ],
      feats: [
        { t: 'Notified when you pass by', s: 'A notification when a Souvnir is waiting nearby, even when the app is closed.', mock: 'notif' },
        { t: 'A photo with your voice', s: 'The place, the moment, and what you wanted to say.', mock: 'photo' },
        { t: 'Your flame', s: 'Drop a Souvnir every day and keep your streak alight.', mock: 'flame' },
      ],
      notif: { app: 'Souvnir', t: 'A Souvnir is waiting nearby', s: 'From Camille · 80 m away' },
      flameLabel: 'day streak',
      ideasTitle: 'Some messages need a place.',
      ideas: [
        { t: 'Couples', s: 'A few words where your story began: a first date, a street you lived on.', img: 'shush' },
        { t: 'Friends', s: 'Jokes, stories, hidden messages: turn your city into a map of memories.', img: 'celebrate' },
        { t: 'Travel', s: 'Share your favourite spots when they become useful: a café in Lisbon, a view in Rome.', img: 'pointing' },
        { t: 'Just for you', s: 'A map that belongs only to you: what you thought, felt or wanted to remember.', img: 'sealed' },
      ],
      cmpTitleA: 'A messaging app sends a message now.',
      cmpTitleB: 'Souvnir leaves it somewhere.',
      cmpA: { t: 'Regular message', q: '“I miss you.”', l: ['It goes out now.', 'Then it disappears in the chat.'] },
      cmpB: { t: 'A Souvnir', q: '“Listen to me here.”', l: ['It travels with the place.', 'And comes back when the moment matters.'] },
      privTitleA: 'Your voice, your places,', privTitleB: 'your control.',
      privBody: 'A Souvnir can stay personal or be shared with the people you choose, and only them.',
      privList: ['Data encrypted in transit and at rest', 'No personal data sold, no ads', 'Location only used to place your Souvnirs and notify you', 'You can delete your account and its content'],
      privCta: 'Read the privacy policy',
      priceTitleA: 'Start for free.', priceTitleB: 'Go Souvnir+ whenever you like.',
      faqTitle: 'FAQ',
      faq: [
        { q: 'What is a Souvnir?', a: 'A voice note tied to a place. You can add a photo, keep it for yourself or share it with someone close.' },
        { q: 'What happens when I pass near the place again?', a: 'Souvnir uses your location to recognise that you are near a place where a Souvnir is waiting, and sends you a notification, even when the app is closed.' },
        { q: 'Is Souvnir free?', a: `Yes. Free gives you up to ${LIMITS.free.notes} active Souvnirs and ${LIMITS.free.friends} friends, with ${LIMITS.free.seconds}-second voice notes; a Souvnir is erased once it has been listened to on site. Souvnir+ (${p(PRICES.monthly)} per month or ${p(PRICES.yearly)} per year) removes these limits and keeps your Souvnirs after listening.` },
        { q: 'Can I keep my Souvnirs private?', a: 'Yes. A Souvnir can be created just for you, or shared only with the people you choose.' },
        { q: 'Why does Souvnir need my location?', a: 'To tie your Souvnirs to places and notify you when you are near one. You can turn off location access at any time in your iPhone settings.' },
        { q: 'Is Souvnir available on Android?', a: 'Not yet: Souvnir is available on iPhone, in English and French.' },
      ],
    }

const imgs = { shush, celebrate, pointing, sealed }
const path = ROUTES.home[lang]
const jsonLd = [organization(), website(), app(lang), faqPage(`${SITE}${path}#faq`, c.faq)]
---

<Base lang={lang} title={c.title} description={c.description} path={path} alternates={{ fr: ROUTES.home.fr, en: ROUTES.home.en }} jsonLd={jsonLd}>
  <div class="wrap stack">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"><Image src={mapWide} alt="" width={1000} quality={70} loading="eager" /></div>
      <div class="hero-copy">
        <h1 class="display">{c.h1a} <span class="hl">{c.h1b}</span></h1>
        <p class="hero-lede"><strong>{c.lede}</strong> {c.lede2}</p>
        <StoreButtons lang={lang} note={false}>
          <a class="btn btn-ghost try" href="#how">{c.howCta} <span aria-hidden="true">↓</span></a>
        </StoreButtons>
        <ul class="trust">
          {c.trust.map((tr) => (
            <li>
              <span class="ti"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tr.svg} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span><b>{tr.t}</b><small>{tr.s}</small></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="hero-art"><CardFan lang={lang} /></div>
    </section>

    <!-- COMMENT ÇA MARCHE + FONCTIONNALITÉS -->
    <section class="bento" id="how">
      <article class="how reveal">
        <Image class="how-bg" src={map} alt="" width={700} loading="lazy" />
        <div class="how-body">
          <h2 class="display">{c.howTitle}</h2>
          <p class="how-sub">{c.howSub}</p>
          <ol class="steps">
            {c.steps.map((st, i) => (
              <li><span class="sn">{`0${i + 1}`}</span><span><b>{st.t}</b><small>{st.s}</small></span></li>
            ))}
          </ol>
        </div>
      </article>
      <div class="feats">
        {c.feats.map((f) => (
          <div class="card feat reveal">
            <div><h3>{f.t}</h3><p>{f.s}</p></div>
            {f.mock === 'notif' && (
              <div class="mock notif" aria-hidden="true">
                <span class="nhead"><i></i>{c.notif.app}</span><b>{c.notif.t}</b><small>{c.notif.s}</small>
              </div>
            )}
            {f.mock === 'photo' && (
              <div class="mock photo" aria-hidden="true">
                <span class="pol"><Image src={mapWide} alt="" width={200} loading="lazy" /></span>
                <span class="mini-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>0:12</span>
              </div>
            )}
            {f.mock === 'flame' && (
              <div class="mock flame" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 22c4 0 7-2.7 7-6.6 0-3.6-2.4-5.6-3.6-8.4-.4 1.8-1.4 3-2.6 3.4.3-3.2-1-6-3.8-8.4.2 3.4-1.4 5.4-3 7.2C4.9 10.5 5 12.8 5 15.4 5 19.3 8 22 12 22Z" /></svg>
                <span><b>9</b><small>{c.flameLabel}</small></span>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- IDÉES -->
    <section class="ideas" id="ideas">
      <h2 class="display">{c.ideasTitle}</h2>
      <div class="igrid">
        {c.ideas.map((it, k) => (
          <figure class="idea reveal">
            <div class:list={['iart', `i${k}`]}><Image src={imgs[it.img as keyof typeof imgs]} alt="" width={360} loading="lazy" /></div>
            <figcaption><b>{it.t}</b><span>{it.s}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- COMPARAISON -->
    <section class="panel cmp reveal">
      <h2 class="display">{c.cmpTitleA} <span class="hl">{c.cmpTitleB}</span></h2>
      <div class="cmp-grid">
        <div class="cbox"><small>{c.cmpA.t}</small><p class="cq">{c.cmpA.q}</p>{c.cmpA.l.map((l) => <p class="cl">{l}</p>)}</div>
        <div class="cbox us"><small>{c.cmpB.t}</small><p class="cq">{c.cmpB.q}</p>{c.cmpB.l.map((l) => <p class="cl">{l}</p>)}</div>
      </div>
    </section>

    <!-- VIE PRIVÉE -->
    <section class="priv reveal" id="privacy">
      <div>
        <h2 class="display">{c.privTitleA} <span class="hl">{c.privTitleB}</span></h2>
        <p class="muted">{c.privBody}</p>
        <a class="plink" href={ROUTES.privacy[lang]}>{c.privCta} →</a>
      </div>
      <ol class="plist">{c.privList.map((li, i) => <li><span>{`0${i + 1}`}</span>{li}</li>)}</ol>
    </section>

    <!-- PRIX -->
    <section class="price-sec" id="prix">
      <h2 class="display">{c.priceTitleA} <span class="hl">{c.priceTitleB}</span></h2>
      <PricingPanel lang={lang} />
    </section>
  </div>

  <Faq items={c.faq} title={c.faqTitle} />
  <CtaBand lang={lang} />
</Base>

<style>
  .stack { display: grid; gap: clamp(16px, 2.4vw, 28px); padding-top: 16px; }

  /* ---------- HERO ---------- */
  .hero { position: relative; isolation: isolate; display: grid; gap: 28px; align-items: center; padding: clamp(24px, 5vw, 64px) 0 clamp(12px, 3vw, 32px); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.08fr 1fr; gap: 24px; min-height: 580px; } }
  .hero-bg { position: absolute; z-index: -1; inset: -16px calc(-1 * var(--gutter)) 0; overflow: hidden; pointer-events: none; }
  .hero-bg :global(img) {
    position: absolute; right: 0; top: 0; width: min(1000px, 100%); height: 100%; object-fit: cover; object-position: 50% 50%;
    opacity: 0.5;
    mask-image: radial-gradient(70% 75% at 70% 45%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 75% at 70% 45%, #000, transparent 75%);
  }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: radial-gradient(35% 45% at 72% 45%, rgba(201, 168, 76, 0.16), transparent 70%); }
  .hero h1 { font-size: clamp(36px, 4.8vw, 64px); }
  .hero h1 .hl { display: block; margin-top: 4px; }
  .hero-lede { color: var(--muted); font-size: clamp(16px, 1.5vw, 18px); margin: 24px 0 26px; max-width: 560px; }
  .hero-lede strong { color: var(--text); font-weight: 600; }
  .try { min-height: 54px; padding: 0 20px; font-size: 16px; border-radius: 14px; }
  .trust { list-style: none; margin: 30px 0 0; padding: 22px 0 0; border-top: 1px solid var(--border); display: grid; gap: 14px; grid-template-columns: 1fr; max-width: 660px; }
  @media (min-width: 560px) { .trust { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
  .trust li { display: flex; align-items: center; gap: 11px; }
  .ti { width: 38px; height: 38px; flex: none; display: grid; place-items: center; border-radius: 11px; background: rgba(201, 168, 76, 0.12); border: 1px solid rgba(201, 168, 76, 0.3); color: var(--gold-light); }
  .ti svg { width: 19px; height: 19px; }
  .trust b { display: block; font-weight: 650; font-size: 15px; line-height: 1.25; }
  .trust small { display: block; color: var(--faint); font-size: 13px; line-height: 1.3; }
  .hero-art { position: relative; overflow-x: clip; overflow-y: visible; padding: 0 6px; }
  @media (max-width: 899px) { .hero-art { order: -1; margin: 0 auto -6px; width: 100%; max-width: 420px; } }

  /* ---------- BENTO ---------- */
  .bento { display: grid; gap: 12px; scroll-margin-top: 80px; }
  @media (min-width: 1000px) { .bento { grid-template-columns: 1.15fr 1fr; gap: 16px; } }
  .how { position: relative; overflow: hidden; isolation: isolate; border-radius: var(--radius-lg); border: 1px solid rgba(201, 168, 76, 0.28); background: #0b0f17; }
  .how :global(.how-bg) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; opacity: 0.45; }
  .how::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, rgba(14, 17, 23, 0.96) 35%, rgba(14, 17, 23, 0.6)); }
  .how-body { padding: clamp(22px, 3vw, 34px); }
  .how h2 { font-size: clamp(26px, 3vw, 38px); }
  .how-sub { margin: 10px 0 0; color: var(--muted); max-width: 520px; }
  .steps { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; max-width: 560px; }
  .steps li { display: flex; gap: 14px; align-items: flex-start; background: rgba(24, 29, 40, 0.75); border: 1px solid var(--border); border-radius: 14px; padding: 12px 14px; backdrop-filter: blur(4px); }
  .sn { flex: none; font-family: var(--font-brand); font-style: italic; font-weight: 600; font-size: 20px; color: var(--gold-light); width: 30px; }
  .steps b { display: block; font-weight: 650; font-size: 15px; }
  .steps small { display: block; color: var(--muted); font-size: 13.5px; margin-top: 2px; }

  .feats { display: grid; gap: 12px; }
  .feat { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 16px; padding: 18px 20px; }
  .feat h3 { font-weight: 650; font-size: 17px; }
  .feat p { margin: 5px 0 0; color: var(--muted); font-size: 14px; max-width: 360px; }
  .mock { display: flex; align-items: center; }
  .notif { flex-direction: column; align-items: flex-start; width: 190px; padding: 10px 12px; border-radius: 16px; background: rgba(242, 234, 216, 0.1); border: 1px solid var(--border-strong); backdrop-filter: blur(8px); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4); }
  .nhead { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--faint); font-weight: 600; }
  .nhead i { width: 14px; height: 14px; border-radius: 4px; background: var(--accent); }
  .notif b { font-size: 13px; margin-top: 4px; line-height: 1.25; }
  .notif small { font-size: 12px; color: var(--muted); }
  .photo { position: relative; width: 120px; height: 92px; }
  .pol { position: absolute; left: 6px; top: 0; width: 92px; padding: 5px 5px 18px; background: #fdf6ee; border-radius: 4px; transform: rotate(-6deg); box-shadow: 0 8px 18px rgba(0, 0, 0, 0.45); }
  .pol :global(img) { width: 100%; height: 64px; object-fit: cover; border-radius: 2px; }
  .mini-play { position: absolute; right: 0; bottom: 4px; display: inline-flex; align-items: center; gap: 4px; padding: 4px 9px 4px 5px; border-radius: 999px; background: var(--accent); color: #fff; font-size: 12px; font-weight: 700; }
  .mini-play svg { width: 14px; height: 14px; fill: #fff; }
  .flame { gap: 8px; }
  .flame svg { width: 34px; height: 34px; fill: var(--accent-hot); filter: drop-shadow(0 0 10px rgba(224, 138, 92, 0.6)); }
  .flame b { display: block; font-family: var(--font-brand); font-weight: 600; font-size: 30px; line-height: 1; }
  .flame small { font-size: 12px; color: var(--faint); }
  @media (max-width: 420px) { .feat { grid-template-columns: 1fr; } .mock { justify-content: flex-start; } }

  /* ---------- IDÉES ---------- */
  .ideas { scroll-margin-top: 80px; margin-top: 10px; display: grid; gap: 18px; }
  .ideas h2 { font-size: clamp(28px, 3.4vw, 42px); max-width: 760px; }
  .igrid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .idea { margin: 0; }
